// Prisma schema for Nova
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OwnerType {
  PERMANENT
  TEMPORARY
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String
  passwordHash       String
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)

  ownerType OwnerType @default(PERMANENT)
  expiresAt DateTime?

  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, username])
  @@index([workspaceId])
  @@index([workspaceId, role])
}