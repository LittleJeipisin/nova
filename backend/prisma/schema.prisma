// Prisma schema for Nova

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  ADMIN
  AGENT
}

enum WidgetPosition {
  LEFT
  RIGHT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OwnerType {
  PERMANENT
  TEMPORARY
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
}

enum MessageSenderType {
  VISITOR
  USER
}

model Workspace {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String         @unique
  status               String         @default("ACTIVE")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  widgetTitle          String         @default("Nova")
  widgetSubtitle       String         @default("Soporte en línea")
  widgetWelcomeMessage String         @default("Hola 👋 ¿En qué podemos ayudarte?")
  widgetPosition       WidgetPosition @default(RIGHT)
  widgetEnabled        Boolean        @default(true)

  sites         Site[]
  users         User[]
  visitors      Visitor[]
  conversations Conversation[]
}

model Site {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name   String
  slug   String
  domain String?
  status String  @default("ACTIVE")

  users         User[]
  visitors      Visitor[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String
  passwordHash       String
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)

  ownerType OwnerType @default(PERMANENT)
  expiresAt DateTime?

  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assignedConversations Conversation[]   @relation("AssignedAgent")
  sentMessages          Message[]        @relation("UserMessages")
  refreshSessions       RefreshSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, username])
  @@index([workspaceId])
  @@index([workspaceId, role])
  @@index([siteId])
  @@index([workspaceId, siteId, role])
}

model RefreshSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Visitor {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  conversations Conversation[]
  sentMessages  Message[]      @relation("VisitorMessages")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  @@index([workspaceId])
  @@index([siteId])
  @@index([workspaceId, siteId])
}

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  status ConversationStatus @default(OPEN)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  visitorId String  @db.Uuid
  visitor   Visitor @relation(fields: [visitorId], references: [id])

  assignedAgentId String? @db.Uuid
  assignedAgent   User?   @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  messages Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([workspaceId])
  @@index([siteId])
  @@index([visitorId])
  @@index([assignedAgentId])
  @@index([workspaceId, status])
  @@index([workspaceId, siteId])
  @@index([workspaceId, siteId, status])
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderType MessageSenderType

  senderUserId String? @db.Uuid
  senderUser   User?   @relation("UserMessages", fields: [senderUserId], references: [id], onDelete: SetNull)

  senderVisitorId String?  @db.Uuid
  senderVisitor   Visitor? @relation("VisitorMessages", fields: [senderVisitorId], references: [id], onDelete: SetNull)

  type MessageType @default(TEXT)

  content  String?
  mediaUrl String?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderUserId])
  @@index([senderVisitorId])
  @@index([conversationId, createdAt])
}
